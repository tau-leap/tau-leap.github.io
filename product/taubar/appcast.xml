      <enclosure
        url="https://github.com/taubar-app/TauBar/releases/download/v1.0/TauBar.zip"
        sparkle:edSignature="REPLACE_WITH_ED_SIGNATURE"
        length="0"
        type="application/octet-stream" />
      <description><![CDATA[
        <h2>TauBar 1.0</h2>
        <ul>
          <li>Initial public release</li>
          <li>10-day trial, license activation</li>
        </ul>
